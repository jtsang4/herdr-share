{
	"name": "herdr-share-web",
	"private": true,
	"description": "Guest web client for herdr-share: a live, end-to-end encrypted view of a shared Herdr terminal.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"lint": "oxfmt --check && oxlint --deny-warnings",
		"format": "oxfmt && oxlint --fix"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@noble/ciphers": "^2.4.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"svelte": "^5.59.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.21.0"
}
